{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "quick-bite-d7815",
          "appId": "1:1072517323194:android:49b416e8cfaf2f4c24e583",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "quick-bite-d7815",
          "configurations": {
            "android": "1:1072517323194:android:49b416e8cfaf2f4c24e583",
            "ios": "1:1072517323194:ios:fab5e290248f7e2224e583"
          }
        }
      }
    }
  },

  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },

  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],

  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },

  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}