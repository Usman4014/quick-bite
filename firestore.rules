rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // ADMIN HELPER
    // ============================================================

    function isAdmin() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if request.auth != null
        && request.auth.uid == userId;


      // ==========================================================
      // USER ADDRESSES
      // ==========================================================

      match /addresses/{addressId} {

        allow read, create, update, delete:
          if request.auth != null
          && request.auth.uid == userId;
      }
    }


    // ============================================================
    // ADMINS
    // ============================================================

    match /admins/{adminId} {

      allow read: if request.auth != null
        && request.auth.uid == adminId;

      allow create, update, delete: if false;
    }


    // ============================================================
    // ORDERS
    // ============================================================

    match /orders/{orderId} {

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow read: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // RIDERS
    // ============================================================

    match /riders/{riderId} {

      allow read, create, update, delete: if isAdmin();
    }


    // ============================================================
    // CATEGORIES
    // ============================================================

    match /categories/{categoryId} {

      allow read: if request.auth != null
        && (
          isAdmin()
          || resource.data.isActive == true
        );

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // PRODUCTS
    // ============================================================

    match /products/{productId} {

      allow read: if request.auth != null
        && (
          isAdmin()
          || resource.data.isActive == true
        );

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // SPECIAL DEALS
    // ============================================================

    match /specialDeals/{dealId} {

      allow read: if request.auth != null
        && (
          isAdmin()
          || resource.data.isActive == true
        );

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // PROMO CODES
    // ============================================================

    match /promoCodes/{promoCodeId} {

      allow read: if request.auth != null
        && (
          isAdmin()
          || resource.data.isActive == true
        );

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // OFFERS
    // ============================================================

    match /offers/{offerId} {

      allow read: if request.auth != null
        && (
          isAdmin()
          || resource.data.isActive == true
        );

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // BANNERS
    // ============================================================

    match /banners/{bannerId} {

      allow read: if resource.data.isActive == true
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // REVIEWS
    // ============================================================

    match /reviews/{reviewId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && (
          (
            request.resource.data.productId != null
            && request.resource.data.specialDealId == null
          )
          ||
          (
            request.resource.data.productId == null
            && request.resource.data.specialDealId != null
          )
        );

      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }


    // ============================================================
    // APP REVIEWS
    // ============================================================

    match /appReviews/{reviewId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      allow update, delete: if isAdmin()
        || (
          request.auth != null
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
        );
    }


    // ============================================================
    // CUSTOMER NOTIFICATIONS
    // ============================================================

    match /customer_notifications/{notificationId} {

      allow read: if request.auth != null
        && (
          isAdmin()
          ||
          resource.data.target == 'all_customers'
          ||
          (
            resource.data.target == 'specific_customer'
            && resource.data.targetId == request.auth.uid
          )
        );

      allow create, update, delete: if isAdmin();

      // Customer can create notification for admin-side
      // notification workflow.
      allow create: if request.auth != null
        && request.resource.data.targetId == request.auth.uid;
    }


    // ============================================================
    // CUSTOMER NOTIFICATION READ STATUS
    // ============================================================

    match /customer_notifications/{notificationId}/read_status/{userId} {

      allow read, create, update, delete: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == userId
        );
    }


    // ============================================================
    // ADMIN NOTIFICATIONS
    // ============================================================

    match /admin_notifications/{notificationId} {

      allow read, update, delete: if isAdmin();

      allow create: if request.auth != null
        && request.resource.data.type == 'new_order'
        && request.resource.data.source == 'customer'
        && request.resource.data.target == 'admin'
        && request.resource.data.isRead == false
        && request.resource.data.orderId != null
        && request.resource.data.targetId == request.auth.uid
        && exists(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        )
        && get(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.userId == request.auth.uid;
    }


    // ============================================================
    // SETTINGS
    // ============================================================

    match /settings/{settingId} {

      allow read: if request.auth != null;

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // FIXED ASSETS
    // ============================================================

    match /fixedAssets/{assetId} {

      allow read: if resource.data.isActive == true
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // NEIGHBORHOODS
    // ============================================================

    match /neighborhoods/{neighborhoodId} {

      allow read: if request.auth != null
        && (
          isAdmin()
          || resource.data.isActive == true
        );

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // ADDRESS TYPES
    // ============================================================

    match /addressTypes/{addressTypeId} {

      allow read: if request.auth != null
        && (
          isAdmin()
          || resource.data.isActive == true
        );

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}